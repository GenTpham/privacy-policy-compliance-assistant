# OpenRouter API key — get from https://openrouter.ai/settings/keys
# Required for extraction (if OPENAI_API_KEY is not provided, uses OPENROUTER_API_KEY)
OPENROUTER_API_KEY=your-openrouter-api-key-here
# Optional: Use OpenAI for Graph Extraction and RAG (faster, more stable JSON parsing)
# LLM_BACKEND="openai"
# OPENAI_API_KEY=sk-proj-your-openai-api-key-here

# Qdrant Cloud — required for deploy; app reads only (ingest once separately)
QDRANT_URL=https://xxxxxxxxx.us-east.aws.cloud.qdrant.io
QDRANT_API_KEY=qdrant_xxxxxxxxx
# Optional: REST timeout in seconds (default 120)
# QDRANT_TIMEOUT_SECONDS=120
# Optional: skip Cloud verify in pytest only
# QDRANT_SKIP_STARTUP_VERIFY=true
# One-time local ingest only: docker compose --profile local-qdrant up qdrant -d
# then QDRANT_URL=http://localhost:6333

# JWT secret — generate with: openssl rand -hex 32
# REQUIRED: minimum 32 characters
JWT_SECRET=change-me-generate-with-openssl-rand-hex-32

# ── Authentication (Phase 3) ──────────────────────────────────────────────────
# Generate a secure secret: openssl rand -hex 32
# Must be at least 32 characters (AUTH-05). JWT_SECRET may already be set above.

# Admin user credentials — seeded at startup if both are set.
# If not set, the server starts without a seeded user (must seed manually or set these).
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me-before-production

# Neo4j Database
NEO4J_URI=bolt://localhost:7687
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=password


