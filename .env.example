# OpenRouter API key — get from https://openrouter.ai/settings/keys
OPENROUTER_API_KEY=your-openrouter-api-key-here

# Qdrant connection — use "localhost" for local dev, "qdrant" inside Docker Compose
QDRANT_HOST=localhost
QDRANT_PORT=6333
# Optional: leave blank for unauthenticated local Qdrant
QDRANT_API_KEY=

# JWT secret — generate with: openssl rand -hex 32
# REQUIRED: minimum 32 characters
JWT_SECRET=change-me-generate-with-openssl-rand-hex-32

# ── Authentication (Phase 3) ──────────────────────────────────────────────────
# Generate a secure secret: openssl rand -hex 32
# Must be at least 32 characters (AUTH-05). JWT_SECRET may already be set above.

# Admin user credentials — seeded at startup if both are set.
# If not set, the server starts without a seeded user (must seed manually or set these).
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me-before-production
